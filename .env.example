# ══════════════════════════════════════════════════════
# IraqNow Bot — نموذج متغيرات البيئة
# انسخ هذا الملف باسم .env وضع القيم الحقيقية بدون علامات < >
# التشغيل يقرأ هذا الملف تلقائياً (python-dotenv) — لا حاجة لـ export يدوي
# ══════════════════════════════════════════════════════

# ── إلزامي — البوت لا يعمل بدونه ──────────────────────
BOT_TOKEN=<توكن البوت من @BotFather>
ADMIN_ID=<آيدي التليكرام الرقمي لحسابك كأدمن>

# ── اختياري — ميزات الطقس / الأخبار ────────────────────
WEATHER_KEY=
NEWS_KEY=

# ── اختياري — الذكاء الاصطناعي (بدونها تتعطل ميزات AI فقط، الباقي يعمل) ──
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# ── اختياري — نشر تلقائي على فيسبوك/انستغرام ───────────
FB_PAGE_TOKEN=
FB_PAGE_ID=
IG_USER_ID=
IMGBB_API_KEY=

# ── اختياري — نسخ احتياطي تلقائي لقناة تليجرام ─────────
BACKUP_CHANNEL_ID=
BACKUP_STATE_MSG_ID=
